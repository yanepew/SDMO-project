# Shared development key used by every component.
# This is intentionally a legacy weakness for the baseline system.
# Never use this approach in a real system.
LEGACY_SHARED_KEY=legacy-demo-key-for-coursework-only

# Gateway endpoint used by the simulated device.
GATEWAY_URL=http://127.0.0.1:8001

# Cloud endpoint used by the gateway.
CLOUD_URL=http://127.0.0.1:8002
